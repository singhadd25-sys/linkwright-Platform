LINKWRIGHT_DATA=/data
LINKWRIGHT_RATE=10
LINKWRIGHT_RETENTION_DAYS=7
LINKWRIGHT_WORKERS=2
LINKWRIGHT_MAX_UPLOAD_BYTES=20971520
LINKWRIGHT_SESSION_DAYS=7
LINKWRIGHT_TRIAL_DAYS=7

# Administrator bootstrap: only needed if no admin account exists yet.
LINKWRIGHT_ADMIN_EMAIL=admin@example.org
LINKWRIGHT_ADMIN_BOOTSTRAP_TOKEN=generate-a-long-random-one-time-secret
LINKWRIGHT_REQUIRE_APPROVAL=0

# Local testing only: verification link is printed in container logs and returned in the response.
# For public deployment, remove LINKWRIGHT_EMAIL_MODE and configure SMTP below.
LINKWRIGHT_EMAIL_MODE=console
LINKWRIGHT_PUBLIC_URL=http://localhost:8000

# Public email delivery (required for external researcher registration)
LINKWRIGHT_SMTP_HOST=
LINKWRIGHT_SMTP_PORT=587
LINKWRIGHT_SMTP_USER=
LINKWRIGHT_SMTP_PASSWORD=
LINKWRIGHT_SMTP_FROM=
LINKWRIGHT_SMTP_STARTTLS=1
LINKWRIGHT_SURECHEMBL=1

# --- Render Free: outbound SMTP is blocked, so send OTP email over HTTPS (Brevo API, free tier) ---
# Set these as Render environment variables (secret), never in GitHub.
LINKWRIGHT_BREVO_API_KEY=
LINKWRIGHT_MAIL_FROM=
# Behind Render's proxy, use the real client IP for rate limits.
LINKWRIGHT_TRUST_PROXY=1
LINKWRIGHT_COOKIE_SECURE=1
